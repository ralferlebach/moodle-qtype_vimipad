# Distribution rules for `git archive` (the GitHub release tarball/zip).
#
# Principle: the released package is a reproducible source release of the
# plugin — everything Moodle runs — but none of the development or CI machinery.

# --- Never distribute: repository and CI plumbing -------------------------
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpcs.xml          export-ignore

# --- Never distribute: internal documentation -----------------------------
# README.md and CHANGELOG.md ship (they are top level); working notes do not.
/docs               export-ignore

# Everything else ships: the PHP sources, db/, lang/, backup/, pix/, and the
# Moodle-native tests under tests/ (useful to maintainers and plugin review).
